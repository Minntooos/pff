# Example environment. Copy to .env and fill in real values.
# Never commit .env.

APP_NAME=PFF
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pff
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Optional: HuggingFace token for AI image generation (FLUX.1-schnell)
HF_API_KEY=

# Admin panel basic-auth credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Social login (fill in the ones you use)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
