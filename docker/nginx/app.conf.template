map $http_x_forwarded_proto $fastcgi_https {
    default '';
    https   on;
}

server {
    # __PORT__ is replaced by docker/entrypoint.sh ($PORT on Render, 8080 locally).
    listen __PORT__;
    server_name _;
    root /var/www/public;
    index index.php;

    # The app accepts uploads up to 1 GB.
    client_max_body_size 1024M;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_pass 127.0.0.1:9000;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param HTTPS $fastcgi_https;
        # Debian's stock fastcgi_params forwards HTTP_HOST as $host, which drops
        # the port and breaks URL generation behind non-standard ports (:8080).
        fastcgi_param HTTP_HOST $http_host;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
